<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AIfinder" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">#1E40AF</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorSecondaryVariant">#0D9488</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <item name="materialCardViewStyle">@style/Widget.AIfinder.CardView</item>
        <item name="materialCardViewOutlinedStyle">@style/Widget.AIfinder.CardView</item>
    </style>

    <style name="Widget.AIfinder.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>